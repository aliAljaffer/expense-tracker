FROM golang:1.26.0 AS build
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -o /api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /api /api
# distroless nonroot is UID 65532, pinned numerically
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/api"]
