{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Expense Tracker colour theme. One vibrant brand accent, lime, carried on warm neutrals in light mode and near-black green neutrals in dark mode. Every semantic pairing is checked by scripts/validate_contrast.py. Charts use the data-viz ramp, never the action tokens.",

  "primitive": {
    "$description": "Raw palette. Components reference semantic tokens only.",

    "ink": {
      "50":  { "$type": "color", "$value": "#fbfaf7" },
      "100": { "$type": "color", "$value": "#efece3" },
      "200": { "$type": "color", "$value": "#e3dfd4" },
      "300": { "$type": "color", "$value": "#b5b0a2" },
      "400": { "$type": "color", "$value": "#8a8a7c" },
      "600": { "$type": "color", "$value": "#5a5a50" },
      "700": { "$type": "color", "$value": "#3a3a31" },
      "900": { "$type": "color", "$value": "#14140f" },
      "950": { "$type": "color", "$value": "#0a0a07" }
    },

    "lime": {
      "50":  { "$type": "color", "$value": "#f1fbdd" },
      "300": { "$type": "color", "$value": "#d9f99d" },
      "400": { "$type": "color", "$value": "#bef264" },
      "500": { "$type": "color", "$value": "#a3e635" },
      "600": { "$type": "color", "$value": "#84cc16" },
      "700": { "$type": "color", "$value": "#5e9b10" },
      "800": { "$type": "color", "$value": "#4d7c0f" }
    },

    "crimson": {
      "400": { "$type": "color", "$value": "#fb7185" },
      "500": { "$type": "color", "$value": "#e11d48" },
      "600": { "$type": "color", "$value": "#c81e4a" },
      "700": { "$type": "color", "$value": "#a8173e" },
      "800": { "$type": "color", "$value": "#881337" }
    },

    "azure": {
      "400": { "$type": "color", "$value": "#7cc5ff" },
      "500": { "$type": "color", "$value": "#3b93e8" },
      "600": { "$type": "color", "$value": "#0b63c5" },
      "700": { "$type": "color", "$value": "#0a4f9e" }
    },

    "white": { "$type": "color", "$value": "#ffffff" },
    "black": { "$type": "color", "$value": "#000000" }
  },

  "semantic": {
    "action": {
      "primary":         { "$type": "color", "$value": "{primitive.lime.500}" },
      "primary-hover":   { "$type": "color", "$value": "{primitive.lime.600}" },
      "primary-active":  { "$type": "color", "$value": "{primitive.lime.700}" },
      "secondary":       { "$type": "color", "$value": "{primitive.ink.100}" },
      "secondary-hover": { "$type": "color", "$value": "{primitive.ink.200}" },
      "secondary-active":{ "$type": "color", "$value": "{primitive.ink.300}" },
      "destructive":       { "$type": "color", "$value": "{primitive.crimson.600}" },
      "destructive-hover": { "$type": "color", "$value": "{primitive.crimson.700}" },
      "destructive-active":{ "$type": "color", "$value": "{primitive.crimson.800}" }
    },

    "feedback": {
      "success-bg":     { "$type": "color", "$value": "#e6f7ec" },
      "success-text":   { "$type": "color", "$value": "#0b6b3a" },
      "success-border": { "$type": "color", "$value": "#86d9a6" },
      "success-icon":   { "$type": "color", "$value": "#0e8f4c" },
      "warning-bg":     { "$type": "color", "$value": "#fff1d1" },
      "warning-text":   { "$type": "color", "$value": "#7a4e00" },
      "warning-border": { "$type": "color", "$value": "#f0c463" },
      "warning-icon":   { "$type": "color", "$value": "#b7791f" },
      "error-bg":       { "$type": "color", "$value": "#fde7ed" },
      "error-text":     { "$type": "color", "$value": "#a81238" },
      "error-border":   { "$type": "color", "$value": "#f3a3b6" },
      "error-icon":     { "$type": "color", "$value": "{primitive.crimson.600}" },
      "info-bg":        { "$type": "color", "$value": "#e3f3fa" },
      "info-text":      { "$type": "color", "$value": "#0a5578" },
      "info-border":    { "$type": "color", "$value": "#7fc7e4" },
      "info-icon":      { "$type": "color", "$value": "#0b76a8" }
    },

    "text": {
      "primary":        { "$type": "color", "$value": "{primitive.ink.900}" },
      "secondary":      { "$type": "color", "$value": "{primitive.ink.600}" },
      "tertiary":       { "$type": "color", "$value": "{primitive.ink.400}" },
      "disabled":       { "$type": "color", "$value": "{primitive.ink.300}" },
      "on-action":      { "$type": "color", "$value": "{primitive.ink.900}" },
      "on-destructive": { "$type": "color", "$value": "{primitive.white}" },
      "on-dark":        { "$type": "color", "$value": "{primitive.ink.50}" },
      "link":           { "$type": "color", "$value": "{primitive.azure.600}" },
      "link-hover":     { "$type": "color", "$value": "{primitive.azure.700}" }
    },

    "surface": {
      "page":     { "$type": "color", "$value": "{primitive.ink.50}" },
      "card":     { "$type": "color", "$value": "{primitive.white}" },
      "raised":   { "$type": "color", "$value": "{primitive.white}" },
      "sunken":   { "$type": "color", "$value": "{primitive.ink.100}" },
      "overlay":  { "$type": "color", "$value": "rgba(20, 20, 15, 0.55)" },
      "disabled": { "$type": "color", "$value": "{primitive.ink.100}" }
    },

    "border": {
      "default":  { "$type": "color", "$value": "{primitive.ink.200}" },
      "strong":   { "$type": "color", "$value": "{primitive.ink.400}" },
      "focus":    { "$type": "color", "$value": "{primitive.lime.700}" },
      "error":    { "$type": "color", "$value": "{primitive.crimson.500}" },
      "disabled": { "$type": "color", "$value": "{primitive.ink.200}" }
    },

    "interactive": {
      "hover-overlay":   { "$type": "color", "$value": "rgba(20, 20, 15, 0.05)" },
      "active-overlay":  { "$type": "color", "$value": "rgba(20, 20, 15, 0.09)" },
      "selected-bg":     { "$type": "color", "$value": "{primitive.lime.50}" },
      "selected-border": { "$type": "color", "$value": "{primitive.lime.600}" },
      "focus-ring":      { "$type": "color", "$value": "{primitive.lime.700}" }
    }
  },

  "data-viz": {
    "$description": "Categorical series, ordered for hue separation. Series must also differ by shape or direct label.",

    "categorical": {
      "1": { "$type": "color", "$value": "#1d4ed8", "$description": "Blue" },
      "2": { "$type": "color", "$value": "#c2410c", "$description": "Orange" },
      "3": { "$type": "color", "$value": "#047857", "$description": "Emerald" },
      "4": { "$type": "color", "$value": "#be185d", "$description": "Magenta" },
      "5": { "$type": "color", "$value": "#6d28d9", "$description": "Violet" },
      "6": { "$type": "color", "$value": "#0e7490", "$description": "Cyan" },
      "7": { "$type": "color", "$value": "#b45309", "$description": "Amber" },
      "8": { "$type": "color", "$value": "#4a5568", "$description": "Slate" }
    },

    "diverging": {
      "negative":        { "$type": "color", "$value": "#be123c" },
      "negative-strong": { "$type": "color", "$value": "#881337" },
      "neutral":         { "$type": "color", "$value": "#e3dfd4" },
      "positive":        { "$type": "color", "$value": "#15803d" },
      "positive-strong": { "$type": "color", "$value": "#14532d" }
    },

    "axis": {
      "line":  { "$type": "color", "$value": "{semantic.border.strong}" },
      "label": { "$type": "color", "$value": "{semantic.text.secondary}" }
    }
  },

  "dark": {
    "$description": "Dark mode semantic overrides. Swap at :root[data-theme='dark']. Primitive tokens stay constant.",

    "text": {
      "primary":        { "$type": "color", "$value": "#f2f5ec" },
      "secondary":      { "$type": "color", "$value": "#a7b3a4" },
      "tertiary":       { "$type": "color", "$value": "#7a8677" },
      "disabled":       { "$type": "color", "$value": "#4c554b" },
      "on-action":      { "$type": "color", "$value": "#101a05" },
      "on-destructive": { "$type": "color", "$value": "#ffffff" },
      "on-dark":        { "$type": "color", "$value": "#0b0f0c" },
      "link":           { "$type": "color", "$value": "{primitive.azure.400}" },
      "link-hover":     { "$type": "color", "$value": "#a8d8ff" }
    },

    "surface": {
      "page":     { "$type": "color", "$value": "#0b0f0c" },
      "card":     { "$type": "color", "$value": "#131a15" },
      "raised":   { "$type": "color", "$value": "#1a231b" },
      "sunken":   { "$type": "color", "$value": "#050806" },
      "overlay":  { "$type": "color", "$value": "rgba(0, 0, 0, 0.65)" },
      "disabled": { "$type": "color", "$value": "#1a231b" }
    },

    "border": {
      "default":  { "$type": "color", "$value": "#243026" },
      "strong":   { "$type": "color", "$value": "#5c6b5e" },
      "focus":    { "$type": "color", "$value": "{primitive.lime.400}" },
      "error":    { "$type": "color", "$value": "{primitive.crimson.400}" },
      "disabled": { "$type": "color", "$value": "#243026" }
    },

    "action": {
      "primary":           { "$type": "color", "$value": "{primitive.lime.400}" },
      "primary-hover":     { "$type": "color", "$value": "{primitive.lime.300}" },
      "primary-active":    { "$type": "color", "$value": "{primitive.lime.500}" },
      "secondary":         { "$type": "color", "$value": "#1f2a21" },
      "secondary-hover":   { "$type": "color", "$value": "#273429" },
      "secondary-active":  { "$type": "color", "$value": "#2f3d31" },
      "destructive":       { "$type": "color", "$value": "{primitive.crimson.500}" },
      "destructive-hover": { "$type": "color", "$value": "{primitive.crimson.700}" },
      "destructive-active":{ "$type": "color", "$value": "{primitive.crimson.800}" }
    },

    "feedback": {
      "success-bg":     { "$type": "color", "$value": "#0c2a1b" },
      "success-text":   { "$type": "color", "$value": "#6ee7a8" },
      "success-border": { "$type": "color", "$value": "#1d6b45" },
      "success-icon":   { "$type": "color", "$value": "#34d399" },
      "warning-bg":     { "$type": "color", "$value": "#2a2008" },
      "warning-text":   { "$type": "color", "$value": "#fcd34d" },
      "warning-border": { "$type": "color", "$value": "#6b5210" },
      "warning-icon":   { "$type": "color", "$value": "#fbbf24" },
      "error-bg":       { "$type": "color", "$value": "#2c0c16" },
      "error-text":     { "$type": "color", "$value": "#fda4af" },
      "error-border":   { "$type": "color", "$value": "#7a1128" },
      "error-icon":     { "$type": "color", "$value": "#fb7185" },
      "info-bg":        { "$type": "color", "$value": "#0a2430" },
      "info-text":      { "$type": "color", "$value": "#7dd3fc" },
      "info-border":    { "$type": "color", "$value": "#14536b" },
      "info-icon":      { "$type": "color", "$value": "#38bdf8" }
    },

    "interactive": {
      "hover-overlay":   { "$type": "color", "$value": "rgba(255, 255, 255, 0.06)" },
      "active-overlay":  { "$type": "color", "$value": "rgba(255, 255, 255, 0.10)" },
      "selected-bg":     { "$type": "color", "$value": "#1d2a16" },
      "selected-border": { "$type": "color", "$value": "{primitive.lime.800}" },
      "focus-ring":      { "$type": "color", "$value": "{primitive.lime.400}" }
    },

    "data-viz": {
      "categorical": {
        "1": { "$type": "color", "$value": "#60a5fa" },
        "2": { "$type": "color", "$value": "#fb923c" },
        "3": { "$type": "color", "$value": "#34d399" },
        "4": { "$type": "color", "$value": "#f472b6" },
        "5": { "$type": "color", "$value": "#a78bfa" },
        "6": { "$type": "color", "$value": "#22d3ee" },
        "7": { "$type": "color", "$value": "#fbbf24" },
        "8": { "$type": "color", "$value": "#94a3b8" }
      },
      "diverging": {
        "negative":        { "$type": "color", "$value": "#fb7185" },
        "negative-strong": { "$type": "color", "$value": "#f43f5e" },
        "neutral":         { "$type": "color", "$value": "#2f3d31" },
        "positive":        { "$type": "color", "$value": "#34d399" },
        "positive-strong": { "$type": "color", "$value": "#6ee7a8" }
      }
    }
  }
}
